# Copy to .env at the repo root, then run yarn dev.
# Env files load only when NODE_ENV (Nest) or Vite mode is development (case-insensitive).
# Unset, production, staging, test, and any other value never read .env files.
# yarn dev sets NODE_ENV=development; yarn start sets NODE_ENV=production.
# Process environment variables always override file values.

# Backend HTTP port (default 3000)
PORT=3000

# Shared WebSocket gateway token, required unless mock engines are enabled.
# Generate a local token: openssl rand -hex 32
NOOT_WS_TOKEN=

# Same token for the Vite client (Vite exposes only VITE_* to the browser)
VITE_NOOT_WS_TOKEN=

# Optional Socket.IO URL; omit to use same origin through the Vite proxy
# VITE_WS_URL=

# Set to 1 for local mock engines (allows omitting NOOT_WS_TOKEN)
NOOT_BRAINCORE_MOCK_ENGINES=1

# Optional BrainCore paths / caps
# NOOT_BRAINCORE_DATA_DIR=
# NOOT_IDENTITY_CONFIG_DIR=
# NOOT_BRAINCORE_LIVE_SESSION_CAP=3
# NOOT_BRAINCORE_MAX_CHAT_TEXT_LENGTH=100000

# Vite proxy target for /health and /socket.io
# BACKEND_URL=http://localhost:3000

# Reserved: not read by this repo's Nest config layer. Hosts that construct
# engine adapters pass these as constructor options, not via ConfigService.
# LUMO_API_KEY=
# LUMO_BASE_URL=http://localhost:3003/v1
# CURSOR_API_KEY=
