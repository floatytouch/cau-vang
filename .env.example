# Reference list of environment variables. The backend reads the process
# environment only (it never loads .env files); export these in the shell.

# Backend HTTP port (default 3000)
PORT=3000

# Shared WebSocket gateway token, required unless mock engines are enabled.
# Generate one: openssl rand -hex 32
NOOT_WS_TOKEN=

# Same token for the Vite client; Vite reads VITE_* from the shell or apps/frontend/.env.local
VITE_NOOT_WS_TOKEN=

# Set to 1 for local mock engines (allows omitting NOOT_WS_TOKEN)
NOOT_BRAINCORE_MOCK_ENGINES=1

# Optional BrainCore paths / caps
# NOOT_BRAINCORE_DATA_DIR=
# NOOT_IDENTITY_CONFIG_DIR=
# NOOT_BRAINCORE_LIVE_SESSION_CAP=3
# NOOT_BRAINCORE_MAX_CHAT_TEXT_LENGTH=100000

# Vite proxy target for /health and /socket.io
# BACKEND_URL=http://localhost:3000
